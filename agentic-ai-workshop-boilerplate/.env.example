# Copy this file to ".env" (same folder) and fill in your real key.
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
#
# Never commit your real ".env" file. It is already listed in .gitignore.

# Get a free key at https://console.groq.com/keys (requires a free account).
GROQ_API_KEY=your_groq_api_key_here

# Which Groq-hosted model to use. This one supports tool-calling, which every
# phase in this workshop depends on -- don't swap in a model that doesn't
# support tools or the agent loop will silently stop calling tools.
# Full current list: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
